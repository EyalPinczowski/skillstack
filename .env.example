# API (apps/api). Names and safe example values only; never commit real values.

# operational | rnd
APP_ENV=operational
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of exact origins allowed to call the API from a browser.
# Empty means no cross-origin access. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Number of reverse proxies in front of the API (a whole number). 0 trusts nothing, so
# X-Forwarded-For is ignored and the rate limit keys on the connecting address.
# NEEDS CHECK: the correct hop count on Render is not verified yet; it is verified when the
# deployment branch is built. Maximum 5. Setting it higher than the real number of proxy hops lets
# clients spoof their IP and defeats the rate limit. Also needs check: entries written as
# [2001:db8::1] or 1.2.3.4:80 are keyed separately from the plain address, so verify the format
# Render writes at the same time. Leave 0 until then (all clients behind a proxy then share one limit).
TRUST_PROXY=0

# Feature flags: every flag is off. Booleans accept only the exact strings true or false.
# FEATURE_NOTIFICATIONS=true
# FEATURE_SHARING=true
# FEATURE_OFFLINE=true
# FEATURE_PUSH_NOTIFICATIONS=true

# Web app variables live in apps/web/.env.example
