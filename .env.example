# API (apps/api). Names and safe example values only; never commit real values.

# operational | rnd
APP_ENV=operational
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of exact origins allowed to call the API from a browser.
# Empty means no cross-origin access. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Set to true behind a reverse proxy such as Render
TRUST_PROXY=false

# Feature flags: every flag is off unless set to true
# FEATURE_NOTIFICATIONS=true
# FEATURE_SHARING=true
# FEATURE_OFFLINE=true
# FEATURE_PUSH_NOTIFICATIONS=true

# Web app variables live in apps/web/.env.example
