# API (apps/api). Names and safe example values only; never commit real values.

# operational | rnd
APP_ENV=operational
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of exact origins allowed to call the API from a browser.
# Empty means no cross-origin access. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Number of reverse proxies in front of the API (a whole number). 0 trusts nothing, so
# X-Forwarded-For is ignored and the rate limit keys on the connecting address.
# NEEDS CHECK: the correct hop count on Render is not verified yet; it is verified when the
# deployment branch is built. Maximum 5. Setting it higher than the real number of proxy hops lets
# clients spoof their IP and defeats the rate limit. Also needs check: entries written as
# [2001:db8::1] or 1.2.3.4:80 are keyed separately from the plain address, so verify the format
# Render writes at the same time. Leave 0 until then (all clients behind a proxy then share one limit).
TRUST_PROXY=0

# Accounts and sign-in (spec 3.A). Names only. The first three below, plus SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY, are required when NODE_ENV=production.
# See docs/setup/api-auth.md. Without them, sign-in rejects every token and account routes answer 503.
# development | test | production
NODE_ENV=development
# Supabase Auth public signing keys and the token issuer (both https, set both or neither).
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Connection string of the app_<schema> login (app_prod or app_rnd), never the admin account.
# Supabase project URL and the service-role (secret) key. Used only to delete the Supabase Auth
# user on "Delete my account". The key is a SERVER-ONLY secret: Render only, never Vercel, the web
# app or git. Both required when NODE_ENV=production; set both or neither elsewhere (without
# them, account deletion answers 502 and deletes nothing).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgres://app_rnd.<project-ref>:<password>@<pooler-host>:5432/postgres

# Feature flags: every flag is off. Booleans accept only the exact strings true or false.
# FEATURE_NOTIFICATIONS=true
# FEATURE_SHARING=true
# FEATURE_OFFLINE=true
# FEATURE_PUSH_NOTIFICATIONS=true
# FEATURE_AI_OVERVIEW=true
# Paid AI providers are refused unless this is true. No paid provider exists; leave it off ($0 rule).
# AI_ALLOW_PAID=true

# Web app variables live in apps/web/.env.example
