# Which environment this build is for: operational | rnd | demo
VITE_APP_ENV=operational
# Base URL of the API, without a trailing slash
VITE_API_URL=http://localhost:3000
# Supabase project URL, e.g. https://<project-ref>.supabase.co (Project Settings, API)
VITE_SUPABASE_URL=
# The project's anon / publishable key. Public by design (it ships in the browser bundle), but
# paste the real value only into your own untracked .env.local or the Vercel settings, never here.
VITE_SUPABASE_ANON_KEY=
