{
  "name": "@skillstack/api",
  "version": "0.0.0",
  "private": true,
  "description": "Skillstack REST API (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi:dump": "tsx scripts/openapi-dump.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@skillstack/shared": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@skillstack/db": "workspace:*",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0"
  }
}
